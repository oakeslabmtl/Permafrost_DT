{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoundaryConditionMessage",
  "description": "Boundary condition snapshot for 2D FEM inputs.",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "time_hours": { "type": "number" },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "boundary_set": { "type": "string" },
          "bc_type": { "type": "string", "enum": ["dirichlet", "neumann", "robin"] },
          "temperature": { "type": ["number", "null"] },
          "heat_flux": { "type": ["number", "null"] },
          "h_coeff": { "type": ["number", "null"] },
          "temperature_profile": {
            "type": ["array", "null"],
            "description": "Depth-resolved boundary temperature; overrides the scalar temperature when present.",
            "items": {
              "type": "object",
              "properties": {
                "z_m": { "type": "number" },
                "temperature": { "type": "number" }
              },
              "required": ["z_m", "temperature"],
              "additionalProperties": false
            }
          }
        },
        "required": ["boundary_set", "bc_type"],
        "additionalProperties": false
      }
    },
    "sensors": {
      "type": "array",
      "description": "Optional sensor snapshot passed through for FEM initial-condition seeding (single timestep).",
      "items": {
        "type": "object",
        "properties": {
          "sensor_id": { "type": "string" },
          "x_m": { "type": "number" },
          "y_m": { "type": ["number", "null"] },
          "z_m": { "type": "number" },
          "temperature": { "type": "number" }
        },
        "required": ["sensor_id", "x_m", "z_m", "temperature"],
        "additionalProperties": false
      }
    },
    "include_field": { "type": "boolean", "description": "Capture temperature field snapshot" },
    "save_field_csv": { "type": "boolean", "description": "Write temperature field to CSV" },
    "field_csv_dir": { "type": "string", "description": "Directory for field CSV files" },
    "material_override": { "type": "object", "description": "Optional material property overrides" }
  },
  "required": ["time_hours", "boundaries"],
  "additionalProperties": false
}
