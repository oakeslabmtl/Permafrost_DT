{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FEMInversionOutputMessage",
  "description": "Output message for the FEM inversion service",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "parameters": {
      "description": "Inverted soil parameters; keys follow fem_inversion.invert_params.",
      "type": "object",
      "properties": {
        "cap_s": { "type": "number" },
        "k_parameter": { "type": "number" },
        "lambda_s": { "type": "number" }
      }
    }
  },
  "required": ["status", "parameters"]
}
