{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipeCalibrationOutputMessage",
  "description": "Output of the pipe (heat-exchanger loop) calibration service.",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "time_hours": { "type": "number" },
    "site_id": { "type": "string" },
    "parameters": {
      "type": "object",
      "properties": {
        "v": { "type": "number" },
        "kf": { "type": "number" },
        "kw": { "type": "number" },
        "kloss": { "type": "number" },
        "Tw0": { "type": "number" },
        "Tenv": { "type": "number" }
      }
    },
    "interface_temperature_c": { "type": ["number", "null"] },
    "pipe_boundary_set": { "type": "string" },
    "rmse": { "type": ["number", "null"] },
    "mae": { "type": ["number", "null"] },
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "eval_count": { "type": "integer" },
    "n_samples": { "type": "integer" },
    "travel_time_min": { "type": ["number", "null"] }
  },
  "required": ["status", "parameters"]
}
